# From each app's AWS envs/*/terraform.tfvars origin_verify_secret (never commit real values).
blockdrop_stg_origin_verify_secret  = "replace-with-blockdrop-stg-secret"
blockdrop_prod_origin_verify_secret = "replace-with-blockdrop-prod-secret"
netrunner_stg_origin_verify_secret  = "replace-with-netrunner-stg-secret"
netrunner_prod_origin_verify_secret = "replace-with-netrunner-prod-secret"
dressme_stg_origin_verify_secret    = "replace-with-dressme-stg-secret"
dressme_prod_origin_verify_secret   = "replace-with-dressme-prod-secret"
homepage_stg_origin_verify_secret   = "replace-with-homepage-stg-secret"
homepage_prod_origin_verify_secret  = "replace-with-homepage-prod-secret"

