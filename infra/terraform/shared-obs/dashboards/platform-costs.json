  "tags": [
    "platform",
    "costs",
    "eur",
    "shared-obs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "infinity",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {
          "text": "Platform costs",
          "value": "infinity-platform"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Currency: EUR (\u20ac).** Latest month in feed: `2026-10`.\n\nP0: edit `costs/monthly.json`, run `scripts/generate-costs-dashboard.py`, `terraform apply` in `shared-obs`. Later: AWS Cost Explorer / vendor APIs where available; subscriptions may stay manual."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total \u2014 2026-10",
      "description": "Sum of vendor amounts for the latest month in costs/monthly.json.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "inline",
          "format": "table",
          "parser": "backend",
          "data": "[{\"label\":\"Total\",\"amount_eur\":0.0,\"month\":\"2026-10\"}]",
          "root_selector": "",
          "columns": [
            {
              "selector": "label",
              "text": "Label",
              "type": "string"
            },
            {
              "selector": "amount_eur",
              "text": "EUR",
              "type": "number"
            }
          ],
          "filters": [],
          "url": "",
          "url_options": {
            "method": "GET",
            "data": ""
          }
        }
      ]
    },
