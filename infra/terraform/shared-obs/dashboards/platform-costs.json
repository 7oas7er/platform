{
  "uid": "platform-costs",
  "title": "Platform \u2014 Costs (EUR)",
  "description": "Cross-project operator spend (EUR). Non-AWS from costs/monthly.json; AWS from CloudWatch EstimatedCharges \u00d7 Frankfurter when aws_live is true.",
  "tags": [
    "platform",
    "costs",
    "eur",
    "shared-obs",
    "aws"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "1h",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "infinity",
        "type": "datasource",
        "query": "yesoreyeram-infinity-datasource",
        "current": {
          "text": "Platform costs",
          "value": "infinity-platform"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "cloudwatch",
        "type": "datasource",
        "query": "cloudwatch",
        "current": {
          "text": "CloudWatch Billing",
          "value": "cloudwatch-billing"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Currency: EUR (\u20ac).** Manual feed month: `2026-10`.\n\nNon-AWS vendors: edit `costs/monthly.json`, run `scripts/generate-costs-dashboard.py`, `terraform apply`.\n\n**AWS is automated:** CloudWatch `AWS/Billing` `EstimatedCharges` (USD, us-east-1, month-to-date) \u00d7 [Frankfurter](https://www.frankfurter.app/) USD\u2192EUR. One-time: enable **Receive CloudWatch Billing Alerts** in AWS Billing preferences. Updates several times daily \u2014 no monthly.json edit."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Non-AWS vendors \u2014 2026-10",
      "description": "Sum of operator-maintained rows in costs/monthly.json (AWS excluded).",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${infinity}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "MANUAL",
          "type": "json",
          "source": "inline",
          "format": "table",
          "parser": "backend",
          "data": "[{\"label\":\"Non-AWS vendors\",\"amount_eur\":0.0,\"month\":\"2026-10\"}]",
          "root_selector": "",
          "columns": [
            {
              "selector": "label",
              "text": "Label",
              "type": "string"
            },
            {
              "selector": "amount_eur",
              "text": "EUR",
              "type": "number"
            }
          ],
          "filters": [],
          "url": "",
          "url_options": {
            "method": "GET",
            "data": ""
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "AWS MTD (EUR, live)",
      "description": "EstimatedCharges (USD) \u00d7 Frankfurter USD\u2192EUR. Requires billing alerts enabled; metric lives in us-east-1.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "USD",
          "queryMode": "Metrics",
          "namespace": "AWS/Billing",
          "metricName": "EstimatedCharges",
          "dimensions": {
            "Currency": [
              "USD"
            ]
          },
          "statistic": "Maximum",
          "period": "21600",
          "region": "us-east-1",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "expression": "",
          "sqlExpression": "",
          "label": "AWS USD MTD",
          "id": "",
          "hide": true,
          "datasource": {
            "type": "cloudwatch",
            "uid": "${cloudwatch}"
          }
        },
        {
          "refId": "FX",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "https://api.frankfurter.app/latest?from=USD&to=EUR",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "",
          "columns": [
            {
              "selector": "date",
              "text": "Time",
              "type": "timestamp"
            },
            {
              "selector": "rates.EUR",
              "text": "eur_per_usd",
              "type": "number"
            }
          ],
          "filters": [],
          "data": "",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${infinity}"
          },
          "hide": true
        },
        {
          "refId": "USD_R",
          "type": "reduce",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "USD",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "refId": "FX_R",
          "type": "reduce",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "FX",
          "reducer": "last",
          "settings": {
            "mode": "dropNN"
          },
          "hide": true
        },
        {
          "refId": "EUR",
          "type": "math",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "$USD_R * $FX_R",
          "hide": false
        }
      ]
    },
