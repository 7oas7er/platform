#!/usr/bin/env bash
# Export Bitwarden Secure Notes (hidden custom fields) into local terraform.tfvars.
# Scripts contain no secrets — they only talk to `bw` and write files under DEVEL_ROOT.
# Never prints secret field values to stdout/stderr.
#
# Usage:
#   export BW_SESSION="$(bw unlock --raw)"
#   bw-export-tfvars [--dry-run] [--force] [DEVEL_ROOT]
#
# Defaults:
#   DEVEL_ROOT = ~/SynologyDrive/private/devel
#   Collection = $BW_TFVARS_COLLECTION or 7oas7er-terraform
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bw-export-tfvars [--dry-run] [--force] [DEVEL_ROOT]

Write terraform.tfvars under DEVEL_ROOT from Bitwarden Secure Notes named
"{project} / {relative/path}" (typically in collection 7oas7er-terraform).

  --dry-run   Report paths that would be written; do not create/overwrite files
  --force     Overwrite an existing terraform.tfvars (default: skip)
  -h, --help  Show this help

Environment:
  BW_SESSION              Required (bw unlock --raw)
  BW_TFVARS_COLLECTION    Collection name (default: 7oas7er-terraform)

Never prints secret values. Existing files are skipped unless --force.
EOF
}

DRY_RUN=0
FORCE=0
ROOT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      if [[ -n "$ROOT" ]]; then
        echo "Unexpected argument: $1" >&2
        usage >&2
        exit 2
      fi
      ROOT="$1"
      shift
      ;;
  esac
done

ROOT="${ROOT:-$HOME/SynologyDrive/private/devel}"
COLLECTION_NAME="${BW_TFVARS_COLLECTION:-7oas7er-terraform}"

if [[ -z "${BW_SESSION:-}" ]]; then
  echo "Set BW_SESSION first: export BW_SESSION=\"\$(bw unlock --raw)\"" >&2
  exit 1
fi

for cmd in bw jq python3; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Missing required command: $cmd" >&2
    exit 1
  fi
done

COLLECTION_ID="$(bw list collections --search "$COLLECTION_NAME" | jq -r --arg n "$COLLECTION_NAME" '.[] | select(.name==$n) | .id' | head -1 || true)"
if [[ -z "$COLLECTION_ID" ]]; then
  echo "Collection '$COLLECTION_NAME' not found. Create it in Bitwarden or set BW_TFVARS_COLLECTION." >&2
  exit 1
fi

# List items in the collection. Filter names matching "{project} / {path}".
# Field values stay inside jq/python only — never echoed.
items_json="$(bw list items --collectionid "$COLLECTION_ID")"

# Emit one JSON object per matching item: {name, project, rel, fields:[{name,value}]}
# Name pattern: "project / relative/path" (spaces around slash).
mapfile -t item_rows < <(jq -c --arg root "$ROOT" '
  .[]
  | select(.name | test("^[^/]+ / .+"))
  | . as $item
  | ($item.name | capture("^(?<project>[^/]+?) / (?<rel>.+)$")) as $p
  | {
      name: $item.name,
      project: ($p.project | gsub("^\\s+|\\s+$";"")),
      rel: ($p.rel | gsub("^\\s+|\\s+$";"")),
      fields: ([($item.fields // [])[] | {name, value}] )
    }
' <<<"$items_json")

written=0
skipped=0
empty=0

for row in "${item_rows[@]+"${item_rows[@]}"}"; do
  name="$(jq -r '.name' <<<"$row")"
  project="$(jq -r '.project' <<<"$row")"
  rel="$(jq -r '.rel' <<<"$row")"
  field_count="$(jq '.fields | length' <<<"$row")"
  target="$ROOT/$project/$rel/terraform.tfvars"

  if [[ "$field_count" -eq 0 ]]; then
    echo "skip (no fields): $name" >&2
    empty=$((empty + 1))
    continue
  fi

  if [[ -e "$target" && "$FORCE" -eq 0 ]]; then
    echo "skip (exists): $target" >&2
    skipped=$((skipped + 1))
    continue
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "would write: $target ($field_count fields)" >&2
    written=$((written + 1))
    continue
  fi

  mkdir -p "$(dirname "$target")"
  # Write tfvars via python so values never appear in shell expansions / set -x.
  # Pass fields JSON on stdin; path as argv.
  jq -c '.fields' <<<"$row" | python3 - "$target" <<'PY'
import json, sys
path = sys.argv[1]
fields = json.load(sys.stdin)
lines = [
    "# Generated by platform/tools/bw-export-tfvars — do not commit",
]
for f in fields:
    key = f.get("name") or ""
    if not key:
        continue
    val = f.get("value")
    if val is None:
        val = ""
    # HCL string literal with minimal escaping
    escaped = str(val).replace("\\", "\\\\").replace('"', '\\"')
    lines.append(f'{key} = "{escaped}"')
with open(path, "w", encoding="utf-8") as out:
    out.write("\n".join(lines) + "\n")
PY

  echo "wrote: $target ($field_count fields)" >&2
  written=$((written + 1))
done

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "Dry-run done. would_write=$written skipped=$skipped empty=$empty" >&2
else
  echo "Done. wrote=$written skipped=$skipped empty=$empty" >&2
fi
